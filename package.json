{
  "name": "mythoria_admin",
  "version": "0.3.0",
  "private": true,
  "type": "module",
  "packageManager": "npm@11.17.0",
  "scripts": {
    "dev": "next dev --turbopack --port 3001",
    "build": "next build",
    "start": "next start --port 3001",
    "lint": "eslint . --max-warnings=0",
    "lint:fix": "eslint . --fix",
    "typecheck": "tsc --noEmit",
    "format": "prettier --check .",
    "format:fix": "prettier --write .",
    "logs": "powershell -NoProfile -ExecutionPolicy Bypass -File .\\scripts\\logs.ps1",
    "test": "jest --detectOpenHandles",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx -r dotenv/config ./src/db/migrate.ts",
    "db:push": "drizzle-kit push",
    "db:reset": "tsx -r dotenv/config ./src/db/reset.ts",
    "db:setup": "npm run db:reset && npm run db:push",
    "db:studio": "drizzle-kit studio",
    "db:seed": "tsx -r dotenv/config ./src/db/seed.ts",
    "sync-workflows-schema": "tsx -r dotenv/config ./scripts/sync-workflows-schema.ts",
    "sync-mythoria-db-schema": "tsx -r dotenv/config ./scripts/sync-mythoria-db-schema.ts",
    "seed:world-book-day": "tsx -r dotenv/config ./scripts/seed-world-book-day-2026.ts",
    "deploy": "powershell -NoProfile -ExecutionPolicy Bypass -File .\\scripts\\deploy.ps1",
    "deploy:fast": "powershell -NoProfile -ExecutionPolicy Bypass -File .\\scripts\\deploy.ps1 -Fast",
    "check:env": "tsx ./scripts/check-env-parity.ts",
    "campaign:migrate-engagement": "tsx -r dotenv/config ./scripts/apply-email-campaign-engagement-migration.ts",
    "campaign:migration-preflight": "tsx ./scripts/verify-email-campaign-engagement-migration.ts",
    "campaign:migration-postflight": "tsx ./scripts/verify-email-campaign-engagement-migration.ts --postflight",
    "campaign:snapshot": "tsx -r dotenv/config ./scripts/backfill-campaign-audience-snapshot.ts"
  },
  "sideEffects": false,
  "dependencies": {
    "@google-cloud/pubsub": "^6.3.2",
    "@google-cloud/storage": "^8.4.0",
    "@google-cloud/workflows": "^6.2.0",
    "@modelcontextprotocol/sdk": "^1.32.2",
    "@types/pg": "^8.23.1",
    "daisyui": "^5.7.50",
    "dotenv": "^18.0.9",
    "drizzle-kit": "^0.31.11",
    "drizzle-orm": "^0.45.4",
    "google-auth-library": "^11.3.2",
    "googleapis": "^189.0.0",
    "handlebars": "^4.7.10",
    "next": "^16.4.3",
    "next-auth": "^5.0.0-beta.32",
    "pg": "^8.23.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-icons": "^5.7.0",
    "react-is": "^19.3.1",
    "recharts": "^3.10.1",
    "rehype-autolink-headings": "^7.1.0",
    "rehype-pretty-code": "^0.14.5",
    "rehype-slug": "^6.0.0",
    "rehype-stringify": "^10.0.1",
    "remark-gfm": "^4.0.1",
    "remark-parse": "^11.0.0",
    "remark-rehype": "^11.1.2",
    "shiki": "^4.5.0",
    "tsx": "^4.23.15",
    "unified": "^11.0.5",
    "unist-util-visit": "^5.2.0",
    "uuid": "^14.0.3",
    "vfile": "^6.0.3",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@next/eslint-plugin-next": "^16.4.3",
    "@tailwindcss/postcss": "^4.3.3",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/jest": "^30.0.0",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "baseline-browser-mapping": "^2.11.34",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.4.3",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.1.1",
    "jest": "^30.5.2",
    "jest-environment-jsdom": "^30.5.2",
    "js-yaml": "^5.5.0",
    "prettier": "^3.9.10",
    "tailwindcss": "^4.3.3",
    "ts-jest": "^29.4.15",
    "typescript": "6.0.3",
    "typescript-eslint": "^8.72.1"
  },
  "engines": {
    "node": "24.18.1"
  },
  "overrides": {
    "esbuild": "0.28.1"
  },
  "allowScripts": {
    "esbuild@0.28.1": true,
    "protobufjs@7.6.6": true,
    "sharp@0.35.5": true,
    "unrs-resolver@1.12.2": true,
    "@parcel/watcher@2.6.0": false
  }
}
